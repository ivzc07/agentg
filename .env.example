# Copy to .env and fill in. docker-compose reads this file automatically.

# Dev bot token from @BotFather (use a separate bot from production).
TELEGRAM_BOT_TOKEN=

# LiteLLM model string, e.g. openai/gpt-4o-mini or anthropic/claude-sonnet-5,
# and the matching provider API key.
MODEL=openai/gpt-4o-mini
MODEL_API_KEY=

# Only needed when running the app outside docker compose:
# DATABASE_URL=postgresql+asyncpg://agentg:agentg@localhost:5432/agentg

# Directory holding the canonical exercise-demo MP4s (see docs/demo-media.md).
# Defaults to /data/demos; in production point it at a persistent volume.
# DEMO_MEDIA_ROOT=/data/demos
