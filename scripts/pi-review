#!/usr/bin/env sh
# Post an automated code review on a GitHub PR using the Pi coding agent
# (pi-dynamic-workflows extension). Greptile-style severity comments.
#
# Inside Herdr (HERDR_ENV=1) the review runs in a visible Pi TUI pane named
# 'pi-review' (created on first use, reused and serialized afterwards).
# Outside Herdr it falls back to a headless `pi -p` run.
#
# Usage: scripts/pi-review <pr-number>
# Requires: pi (with @quintinshaw/pi-dynamic-workflows installed), gh (authenticated).
set -eu

PR="${1:?usage: scripts/pi-review <pr-number>}"
REPO="$(gh repo view --json nameWithOwner --jq .nameWithOwner)"

PROMPT="Run the code-review workflow on GitHub PR ${PR} of repo ${REPO}. \
Fetch the PR diff and description with gh. Run the workflow in the foreground and wait for its complete result before doing anything else. \
Prioritize correctness bugs, broken imports, security problems, and test-coverage gaps; ignore pure style and wording preferences. \
Then act like the Greptile review bot: for each verified finding, post one comment on PR ${PR} via 'gh pr comment' with a severity prefix [P1] (bug or correctness issue, must fix), [P2] (should fix), or [P3] (optional), naming the file and line. \
Only post findings the workflow verified as real; do not pad. Post at most 3 [P3] comments - keep only the most valuable ones. \
If there are no real findings, post a single comment saying the automated review found no issues. \
Sign every comment with '- pi code-review'. \
When done, reply with just the number of findings posted."

# Herdr client binary: PATH may hold a stale copy that cannot talk to a newer
# server, so prefer the installed one when present.
resolve_herdr() {
    if [ -n "${LOCALAPPDATA:-}" ]; then
        installed="$(cygpath "$LOCALAPPDATA" 2>/dev/null)/Programs/Herdr/bin/herdr"
        if [ -x "$installed" ]; then
            printf '%s' "$installed"
            return
        fi
    fi
    printf '%s' herdr
}

# Total '- pi code-review' comments on the PR (issue + inline). --paginate
# emits one count per page, so sum the lines. Prints ERR on API failure so
# callers never mistake an outage for zero comments.
comment_count() {
    a=$(gh api --paginate "repos/${REPO}/issues/${PR}/comments" --jq '[.[] | select(.body | test("pi code-review"))] | length' 2>/dev/null) || { echo ERR; return; }
    b=$(gh api --paginate "repos/${REPO}/pulls/${PR}/comments" --jq '[.[] | select(.body | test("pi code-review"))] | length' 2>/dev/null) || { echo ERR; return; }
    printf '%s\n%s\n' "$a" "$b" | awk '{s += $1} END {print s + 0}'
}

if [ "${HERDR_ENV:-}" = 1 ]; then
    H="$(resolve_herdr)"
    # Reuse the live 'pi-review' agent, or create its pane + agent on first use.
    # herdr's own launcher (agent start) cannot exec npm's `pi` shim on
    # Windows, so type `pi` into the pane's shell and wait for detection.
    if ! "$H" agent get pi-review >/dev/null 2>&1; then
        PANE=$("$H" pane split --current --direction right --cwd "$PWD" --no-focus |
            sed -n 's/.*"pane_id":"\([^"]*\)".*/\1/p' | head -1)
        [ -n "$PANE" ] || { echo "pi-review: could not create a pane" >&2; exit 1; }
        "$H" pane run "$PANE" "pi" >/dev/null
        i=0
        until "$H" agent get "$PANE" 2>/dev/null | grep -q '"agent":"pi"'; do
            i=$((i + 1))
            [ $i -lt 24 ] || { echo "pi-review: pi did not start in pane $PANE" >&2; exit 1; }
            sleep 5
        done
        "$H" agent rename "$PANE" pi-review >/dev/null
    fi
    agent_status() {
        "$H" agent get pi-review 2>/dev/null | sed -n 's/.*"agent_status":"\([a-z]*\)".*/\1/p' | head -1
    }
    # A blocked pi needs an operator, not another queued review - fail fast
    # instead of hanging out the full serialize timeout.
    [ "$(agent_status)" != blocked ] || { echo "pi-review: the pi-review pane is blocked awaiting input - resolve it first" >&2; exit 1; }
    # Serialize: wait for any in-flight review to finish before prompting.
    "$H" agent wait pi-review --until idle --until done --timeout 1800000 >/dev/null
    BEFORE=$(comment_count)
    [ "$BEFORE" != ERR ] || { echo "pi-review: cannot read PR ${PR} comments" >&2; exit 1; }
    # --wait blocks until the agent settles again, i.e. the review ran and
    # every comment was posted; the count afterwards is the full delta.
    "$H" agent prompt pi-review "$PROMPT" --wait --timeout 3000000 >/dev/null
    # --wait also releases on blocked; that is an operator situation, not a
    # finished review.
    [ "$(agent_status)" != blocked ] || { echo "pi-review: pi blocked mid-review on PR ${PR} - check the pane" >&2; exit 1; }
    NOW=$(comment_count)
    if [ "$NOW" = ERR ] || [ "$NOW" -le "$BEFORE" ]; then
        # GitHub's list API can lag right after posting - give it one retry.
        sleep 20
        NOW=$(comment_count)
    fi
    [ "$NOW" != ERR ] || { echo "pi-review: review ran but comment check failed on PR ${PR}" >&2; exit 1; }
    if [ "$NOW" -gt "$BEFORE" ]; then
        echo $((NOW - BEFORE))
        exit 0
    fi
    echo "pi-review: review settled without posting comments on PR ${PR}" >&2
    exit 1
fi

exec pi -p "$PROMPT"
